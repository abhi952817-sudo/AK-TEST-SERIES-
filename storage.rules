rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true
        || (request.auth.token.email == "abhi952817@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    // Question diagram images and charts
    // Read: Public for exam rendering
    // Create: Authenticated users (< 5MB, strict image content types)
    // Update/Delete: Admins only (prevents unauthorized overwrites)
    match /tests/{testId}/questions/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update, delete: if isAdmin();
    }

    match /chart_images/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update, delete: if isAdmin();
    }

    match /question_images/{fileName} {
      allow read: if true;
      allow create: if isAuthenticated() 
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow update, delete: if isAdmin();
    }

    // Live Test PDFs: Only verified Admins can upload or overwrite test PDFs
    match /LiveTests/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() 
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
    }

    match /pdfs/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() 
                    && request.resource.size < 50 * 1024 * 1024
                    && request.resource.contentType == 'application/pdf';
    }

    // Community attachments: exactly one image is referenced by each post.
    // Students can create only inside their own UID folder; no overwrite.
    match /community_images/{uid}/{fileName} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
    }

    // Report evidence is private to the reporting user and Admin moderators.
    match /community_report_evidence/{uid}/{reportId} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }

    // Default deny for unclassified paths
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
