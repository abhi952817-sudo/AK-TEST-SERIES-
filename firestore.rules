rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true
        || (request.auth.token.get('email', '') == 'abhi952817@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // =========================================================================
    // CONFIGURATION & ADMIN SETTINGS
    // Read: Authenticated users only (prevents public web scraping of app settings)
    // Write: Verified Admins only
    // =========================================================================
    match /Config/{configDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /admin_settings/{settingDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Helper: verifies that only safe, non-privileged student profile fields can be modified
    function isAllowedStudentProfileKeys(keysList) {
      return keysList.hasOnly([
        'uid', 'name', 'displayName', 'email', 'phoneNumber', 'stateName', 'cityName',
        'profileImageUri', 'targetExam', 'averageScore', 'totalTestsAttempted',
        'bookmarkedTests', 'bookmarkedQuestions', 'joinedAt',
        'lastBackupAt', 'createdAt', 'updatedAt', 'lastActive', 'batch', 'institute',
        'fcmToken', 'language', 'theme', 'selectedLanguage'
      ]);
    }

    // Helper: test publication policy requires explicit approved/published status and public/official flag
    function isTestPublishedAndApproved(data) {
      return (data.get('status', '') in ['APPROVED', 'Published'])
        && data.get('status', '') != 'Under Review'
        && data.get('status', '') != 'REJECTED'
        && data.get('status', '') != 'DRAFT'
        && (data.get('isPublic', false) == true || data.get('isOfficial', false) == true);
    }

    // Helper: checks whether user account has been suspended by administration
    function isUserBanned(uid) {
      return exists(/databases/$(database)/documents/Users_Data/$(uid))
        && get(/databases/$(database)/documents/Users_Data/$(uid)).data.get('isBanned', false) == true;
    }

    // =========================================================================
    // USERS DATA & PRIVATE PROFILES
    // Read: Owner or Admin only (strictly protects student email, phone & private info)
    // Create: Owner only (strictly limited to safe profile fields) or Verified Admin
    // Update: Owner only (strictly limited to safe profile fields) or Verified Admin
    // Delete: Admin only
    // =========================================================================
    match /Users_Data/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Students can create their own profile with permitted non-authoritative fields only
      allow create: if (isOwner(userId) && isAllowedStudentProfileKeys(request.resource.data.keys())) || isAdmin();

      // Students can update only whitelisted non-authoritative fields, blocking any spoofing of scores, ranks, bans or roles
      allow update: if (isOwner(userId) && isAllowedStudentProfileKeys(request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();

      allow delete: if isAdmin();

      // Test Attempts: Private detailed results and answers
      // Authoritative attempts are recorded by Cloud Functions via the Admin SDK.
      // Direct client creation of verified or ranking-eligible attempts is strictly blocked.
      match /Attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId)
                          && !isUserBanned(userId)
                          && request.resource.data.get('verifiedServerSide', false) == false
                          && request.resource.data.get('countsTowardRanking', false) == false
                          && !('authoritativeScore' in request.resource.data))
                      || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /attempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId)
                          && !isUserBanned(userId)
                          && request.resource.data.get('verifiedServerSide', false) == false
                          && request.resource.data.get('countsTowardRanking', false) == false
                          && !('authoritativeScore' in request.resource.data))
                      || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /Bookmarked_Tests/{testId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /Bookmarked_Questions/{questionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /Bookmarked_Posts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /Liked_Posts/{postId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // PUBLIC LEADERBOARDS & RANKINGS
    // Read: Authenticated students (competitive rankings across exams)
    // Write: Verified Admins & Server Functions only (tamper-proof)
    // =========================================================================
    match /Leaderboard/{entryDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /Leaderboards/{entryDoc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Per-Test Competitive Leaderboard & Rankings
    // Read: Authenticated students
    // Write: Verified Admins & Server Functions only
    match /Test_Leaderboards/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /Entries/{entryDoc} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // =========================================================================
    // OFFICIAL TESTS & QUESTION BANKS
    // Read: Only approved & published tests are readable by students
    //       Draft/Under Review/Rejected tests are restricted to Admins or the creator
    //       Private answer keys and grading metadata are restricted to Admins only
    // Write: Verified Admins only
    // =========================================================================
    match /Tests/{testId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        || resource.data.get('creatorId', '') == request.auth.uid
        || resource.data.get('uploaderId', '') == request.auth.uid
        || resource.data.get('ownerId', '') == request.auth.uid
        || isTestPublishedAndApproved(resource.data)
      );
      allow write: if isAdmin();

      // Protected answer keys: ordinary clients are forbidden from reading or writing
      match /private_keys/{docId} {
        allow read, write: if isAdmin();
      }

      match /questions/{questionId} {
        allow read: if isAuthenticated() && (
          isAdmin()
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('creatorId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('uploaderId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('ownerId', '') == request.auth.uid
          || isTestPublishedAndApproved(get(/databases/$(database)/documents/Tests/$(testId)).data)
        );
        allow write: if isAdmin();
      }

      match /Questions/{questionId} {
        allow read: if isAuthenticated() && (
          isAdmin()
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('creatorId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('uploaderId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests/$(testId)).data.get('ownerId', '') == request.auth.uid
          || isTestPublishedAndApproved(get(/databases/$(database)/documents/Tests/$(testId)).data)
        );
        allow write: if isAdmin();
      }
    }

    match /Tests_Data/{testId} {
      allow read: if isAuthenticated() && (
        isAdmin()
        || resource.data.get('creatorId', '') == request.auth.uid
        || resource.data.get('uploaderId', '') == request.auth.uid
        || resource.data.get('ownerId', '') == request.auth.uid
        || isTestPublishedAndApproved(resource.data)
      );
      allow write: if isAdmin();

      // Protected answer keys: ordinary clients are forbidden from reading or writing
      match /private_keys/{docId} {
        allow read, write: if isAdmin();
      }

      match /questions/{questionId} {
        allow read: if isAuthenticated() && (
          isAdmin()
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('creatorId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('uploaderId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('ownerId', '') == request.auth.uid
          || isTestPublishedAndApproved(get(/databases/$(database)/documents/Tests_Data/$(testId)).data)
        );
        allow write: if isAdmin();
      }

      match /Questions/{questionId} {
        allow read: if isAuthenticated() && (
          isAdmin()
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('creatorId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('uploaderId', '') == request.auth.uid
          || get(/databases/$(database)/documents/Tests_Data/$(testId)).data.get('ownerId', '') == request.auth.uid
          || isTestPublishedAndApproved(get(/databases/$(database)/documents/Tests_Data/$(testId)).data)
        );
        allow write: if isAdmin();
      }
    }

    // Server-protected answer keys: admin/server only
    match /TestAnswerKeys/{testId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // LIVE TESTS & SCHEDULING
    // Read: Authenticated students
    // Write: Verified Admins only
    // Participants: Students can register only themselves
    // =========================================================================
    match /LiveTests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /Participants/{userId} {
        allow read: if isAuthenticated();
        allow write: if (isOwner(userId) && !isUserBanned(userId)) || isAdmin();
      }
    }

    // =========================================================================
    // COMMUNITY TESTS & DISCUSSIONS
    // Read: Authenticated students
    // Create: Authenticated students (must be creator or uploader, non-banned)
    // Update/Delete: Creator or Verified Admin (creatorId and uploaderId cannot be forged or altered)
    // =========================================================================
    match /Shared_Community_Tests/{testId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isUserBanned(request.auth.uid) && (
        request.resource.data.get('creatorId', '') == request.auth.uid
        || request.resource.data.get('uploaderId', '') == request.auth.uid
      );
      allow update: if isAdmin() || (
        isAuthenticated()
        && !isUserBanned(request.auth.uid)
        && (resource.data.get('creatorId', '') == request.auth.uid || resource.data.get('uploaderId', '') == request.auth.uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorId', 'uploaderId'])
      );
      allow delete: if isAdmin() || (
        isAuthenticated()
        && !isUserBanned(request.auth.uid)
        && (resource.data.get('creatorId', '') == request.auth.uid || resource.data.get('uploaderId', '') == request.auth.uid)
      );
    }

    match /Community_Posts/{postId} {
      allow read: if isAuthenticated();
      
      // Author can create posts, but cannot self-assign pinned or official badges, and cannot be banned
      allow create: if isAuthenticated()
                    && !isUserBanned(request.auth.uid)
                    && request.resource.data.creatorId == request.auth.uid
                    && (!('isPinned' in request.resource.data) || request.resource.data.isPinned == false)
                    && (!('isOfficial' in request.resource.data) || request.resource.data.isOfficial == false)
                    && (!('isMonitor' in request.resource.data) || request.resource.data.isMonitor == false);

      // Authors can edit their content without altering badges or creatorId;
      // Other non-banned students can only interact via bounded upvotes (+/-1), views, comments, or personal bookmark;
      // Admins have full moderation rights
      allow update: if isAdmin()
                    || (isAuthenticated()
                        && !isUserBanned(request.auth.uid)
                        && resource.data.creatorId == request.auth.uid 
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isPinned', 'isOfficial', 'isMonitor', 'creatorId']))
                    || (isAuthenticated()
                        && !isUserBanned(request.auth.uid)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'views', 'comments', 'commentsList', 'isBookmarked'])
                        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['upvotes'])
                            || request.resource.data.upvotes == resource.data.upvotes + 1
                            || request.resource.data.upvotes == resource.data.upvotes - 1));

      allow delete: if isAdmin() || (isAuthenticated() && !isUserBanned(request.auth.uid) && resource.data.creatorId == request.auth.uid);
    }

    // =========================================================================
    // IN-APP NOTIFICATIONS & ANNOUNCEMENTS
    // Read: Authenticated students
    // Write: Verified Admins only
    // =========================================================================
    match /UserNotifications/{notifId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // FEEDBACK & ANALYTICS
    // Create: Authenticated students
    // Read/Update/Delete: Verified Admins only
    // =========================================================================
    match /test_feedbacks/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    match /User_Analytics/{eventId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY FOR ALL OTHER PATHS
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
