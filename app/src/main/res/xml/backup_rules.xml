<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Exclude raw un-isolated Room database so multi-user records cannot bypass account isolation -->
    <exclude domain="database" path="neet_test_series_db" />
    <exclude domain="database" path="neet_test_series_db-wal" />
    <exclude domain="database" path="neet_test_series_db-shm" />
    <exclude domain="database" path="app_database" />
    <exclude domain="database" path="app_database-wal" />
    <exclude domain="database" path="app_database-shm" />

    <!-- Exclude account-scoped private files, secure tests and staging directories -->
    <exclude domain="file" path="private_tests" />
    <exclude domain="file" path="secure_ai_tests" />
    <exclude domain="file" path="backup_staging" />

    <!-- Exclude account-specific preferences containing user private state -->
    <exclude domain="sharedpref" path="user_profile_prefs.xml" />
    <exclude domain="sharedpref" path="user_bookmarks_store.xml" />
    <exclude domain="sharedpref" path="test_progress.xml" />
    <exclude domain="sharedpref" path="SyllabusProgress.xml" />
    <exclude domain="sharedpref" path="ak_google_drive_backup_prefs.xml" />
</full-backup-content>
